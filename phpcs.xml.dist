<?xml version="1.0"?>
<ruleset name="zFolio Connector">
	<description>WordPress coding standards for zFolio Connector.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/docs/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress">
		<!-- Classes follow PSR-4 file names (includes/Feed/Client.php). -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Doc blocks use list<string> and array<string, mixed> shapes. -->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
		<!-- Parameters named $list, $class or $parent are never passed by name. -->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
	</rule>

	<!-- The "Silence is golden." placeholders need no file comment. -->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>*/index.php</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FileComment.WrongStyle">
		<exclude-pattern>*/index.php</exclude-pattern>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="bristlecone-zfolio"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bristlecone_zfolio"/>
				<element value="Bristlecone\Zfolio"/>
			</property>
		</properties>
	</rule>
</ruleset>
